# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (POSTGRESQL + POSTGIS)
# ==============================================================================
# NOTA: Para desarrollo local con docker-compose, DB_HOST debe ser 'db'.
# Para scripts corriendo nativamente en tu host, usa 'localhost'.
DB_USER=postgres
DB_PASSWORD=postgres_secure_pass
DB_HOST=db
DB_PORT=5432
DB_NAME=rastreador_db
DATABASE_URL=postgresql://postgres:postgres_secure_pass@db:5432/rastreador_db

# ==============================================================================
# CONFIGURACIÓN DEL BACKEND API (FASTAPI)
# ==============================================================================
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
JWT_SECRET_KEY=change-me-in-production
DEV_USER_ID=00000000-0000-0000-0000-000000000001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000

# ==============================================================================
# CONFIGURACIÓN DEL FRONTEND (NEXT.JS)
# ==============================================================================
# URL pública del backend API (usada por useSWR en el cliente)
# Para desarrollo local: http://localhost:8001
# Para Docker: http://localhost:8001 (el frontend accede desde el browser del usuario)
NEXT_PUBLIC_API_URL=http://localhost:8001
BACKEND_URL=http://localhost:8001
PORT=3000

# En producción (Render) dejá NEXT_PUBLIC_API_URL vacío: el frontend usa paths relativos.
# FRONTEND_DIST=frontend/out
# APP_TIMEZONE=America/Sao_Paulo
# OSRM_URL=
# ROOT_PATH=
#
# Arquitectura Vercel (frontend) + Render (API). No hardcodear el host en el código.
# En Vercel, setear una de estas y redeployar:
#   BACKEND_URL=https://<servicio>.onrender.com
#   VITE_API_URL=https://<servicio>.onrender.com
# En Render, setear:
#   CORS_ORIGINS=https://<proyecto>.vercel.app
#   DATABASE_URL=<url interna de Postgres, no commitear>
