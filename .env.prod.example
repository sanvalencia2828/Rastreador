# ==============================================================================
# Producción en el VPS (docker-compose.prod.yml). Guía: docs/DEPLOY_VPS.md
#
#   cp .env.prod.example .env && chmod 600 .env
#
# Reemplaza TODOS los valores "cambia-..." y no subas .env a git (ya está en .gitignore).
# docker compose usa este archivo para armar DATABASE_URL y se lo pasa entero a la API.
# ==============================================================================

# Subdominio de la API, con su registro A apuntando a la IP del VPS. Sin https:// ni barra final.
API_DOMAIN=api.cambia-tu-dominio.com

# --- Base de datos (solo red interna de Docker) --------------------------------
POSTGRES_USER=rastreador
POSTGRES_DB=rastreador
# Genera la contraseña con:
#   openssl rand -base64 24 | tr '+/' '-_'
# (el tr cambia + y / por - y _: va sin escapar dentro de DATABASE_URL; 24 bytes no dejan '=').
# No uses $ ni comillas: docker compose interpreta $.
POSTGRES_PASSWORD=cambia-esta-contrasena

# --- API --------------------------------------------------------------------
# Firma de las sesiones (JWT). Obligatoria en producción y distinta de change-me-in-production.
# Genérala con:  openssl rand -hex 32
# Si la cambias, todas las sesiones abiertas se cierran.
JWT_SECRET_KEY=cambia-este-secreto

# Orígenes del navegador que pueden llamar a la API, separados por coma, sin barra final:
# la URL de Vercel y tu dominio propio del frontend si lo tienes.
CORS_ORIGINS=https://cambia-tu-proyecto.vercel.app

# OSRM propio para distancias por calle. Vacío = línea recta (Haversine). Nunca un servidor público.
OSRM_URL=

# Registro de cuentas: déjalo en true hasta crear tu cuenta y después pon false
# (docker compose -f docker-compose.prod.yml up -d api para aplicarlo).
REGISTRATION_ENABLED=true

# --- Opcionales (la API ya tiene valores por defecto) ------------------------
# OPTIMIZER_THRESHOLD_ORTOOLS=30
# OPTIMIZER_ORTOOLS_TIME_LIMIT_S=2
# ROUTE_FALLBACK_SPEED_KMH=28
# RASTREADOR_WALK_SPEED_KMH=4 y demás RASTREADOR_* de app/services/street_time.py (ajustes de tiempos por calle)
#
# No hace falta definir: APP_ENV y DATABASE_URL (los fija docker-compose.prod.yml),
# DEV_USER_ID y ALLOW_SYNTHETIC_COORDS (solo desarrollo), API_PORT/API_HOST (la imagen usa 8000).
